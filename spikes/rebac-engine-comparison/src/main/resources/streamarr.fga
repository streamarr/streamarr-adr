model
  schema 1.1

type user

type server
  relations
    define administrator: [user]

type household
  relations
    define owner: [user]
    define admin: [user] or owner
    define member: [user] or admin

type profile
  relations
    define server: [server]
    define shared_with: [household]
    define direct_manager: [user]
    define can_manage: direct_manager or administrator from server or admin from shared_with
    define can_view: member from shared_with

entity Household;

entity Account {
    serverAdmin: Bool,
    homeHousehold: Household,
    householdRole: String,
};

entity Profile {
    sharedHouseholds: Set<Household>,
    directManagers: Set<Account>,
};

action portableRelationshipMutation;

action editProfile appliesTo {
    principal: Account,
    resource: Profile,
};

action viewProfile appliesTo {
    principal: Account,
    resource: Profile,
};

action offerProfileShare in portableRelationshipMutation appliesTo {
    principal: Account,
    resource: Profile,
};

action inviteProfileManager in portableRelationshipMutation appliesTo {
    principal: Account,
    resource: Profile,
};

action initiateProfileClaim in portableRelationshipMutation appliesTo {
    principal: Account,
    resource: Profile,
};

action migrateProfileLifecycle in portableRelationshipMutation appliesTo {
    principal: Account,
    resource: Profile,
};

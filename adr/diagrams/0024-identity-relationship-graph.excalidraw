    {"type": "text", "id": "tl_l4", "x": 1395, "y": 1082, "width": 110, "height": 16, "text": "select Profile", "originalText": "select Profile", "fontSize": 12, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 400047, "version": 1, "versionNonce": 400048, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25},
    {"type": "text", "id": "tl_l5", "x": 1525, "y": 1082, "width": 110, "height": 16, "text": "fresh reauth", "originalText": "fresh reauth", "fontSize": 12, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 400049, "version": 1, "versionNonce": 400050, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25},
    {"type": "text", "id": "tl_l6", "x": 1650, "y": 1082, "width": 120, "height": 16, "text": "ServerAdmin ops", "originalText": "ServerAdmin ops", "fontSize": 12, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 400051, "version": 1, "versionNonce": 400052, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25},
    {"type": "text", "id": "tl_note", "x": 1020, "y": 1106, "width": 720, "height": 16, "text": "everything else trusts the signed snapshot; revocation is bounded by the access-token lifetime (9.5 min)", "originalText": "everything else trusts the signed snapshot; revocation is bounded by the access-token lifetime (9.5 min)", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 400053, "version": 1, "versionNonce": 400054, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25},
    {"type": "rectangle", "id": "e_pin", "x": 1020, "y": 1150, "width": 720, "height": 92, "strokeColor": "#b45309", "backgroundColor": "#fef3c7", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 400055, "version": 1, "versionNonce": 400056, "isDeleted": false, "groupIds": [], "boundElements": [{"id": "e_pin_text", "type": "text"}], "link": null, "locked": false, "roundness": {"type": 3}},
    {"type": "text", "id": "e_pin_text", "x": 1036, "y": 1166, "width": 688, "height": 60, "text": "PIN safety is a lock at Profile selection, not a stored invariant. When a Kid arrives,\nPIN-less Adult and less-restricted Kid Profiles lock in that Household until their own\npeople set a PIN. The Kid is never delayed, PINs are never removed automatically, and\nthere is no cross-row trigger to rebuild; a stale session expires with its access token.", "originalText": "PIN safety is a lock at Profile selection, not a stored invariant. When a Kid arrives,\nPIN-less Adult and less-restricted Kid Profiles lock in that Household until their own\npeople set a PIN. The Kid is never delayed, PINs are never removed automatically, and\nthere is no cross-row trigger to rebuild; a stale session expires with its access token.", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "middle", "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 400057, "version": 1, "versionNonce": 400058, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "e_pin", "lineHeight": 1.25},
    {"type": "text", "id": "footer", "x": 100, "y": 1260, "width": 1400, "height": 16, "text": "supersedes ADR 0022 · authorization engine in ADR 0025 · full rules, scenarios, and rejected alternatives in the ADR text", "originalText": "supersedes ADR 0022 · authorization engine in ADR 0025 · full rules, scenarios, and rejected alternatives in the ADR text", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 400059, "version": 1, "versionNonce": 400060, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25}
  ],
